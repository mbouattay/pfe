{
    "info": {
        "name": "Duality Agency API",
        "description": "Collection complète pour tester l'API NestJS - Duality Agency\n\n🔐 **Auth flow:**\n1. Lance d'abord **POST /auth/login** pour obtenir un access_token\n2. Le token est automatiquement sauvegardé dans la variable `token` via le script de test\n3. Toutes les routes protégées utilisent `Bearer {{token}}` automatiquement",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3000/api",
            "type": "string"
        },
        {
            "key": "token",
            "value": "",
            "type": "string"
        }
    ],
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{token}}",
                "type": "string"
            }
        ]
    },
    "item": [
        {
            "name": "🔐 Auth",
            "item": [
                {
                    "name": "Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200 || pm.response.code === 201) {",
                                    "    const body = pm.response.json();",
                                    "    if (body.access_token) {",
                                    "        pm.collectionVariables.set('token', body.access_token);",
                                    "        console.log('✅ Token sauvegardé:', body.access_token.substring(0, 30) + '...');",
                                    "    }",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"admin@duality.local\",\n  \"password\": \"Admin@123\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/login",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "login"
                            ]
                        },
                        "description": "🔓 Route PUBLIQUE — Pas de token requis\n\nRécupère un access_token JWT. Le token est automatiquement sauvegardé dans la variable `token` de la collection."
                    }
                }
            ]
        },
        {
            "name": "💬 Chat",
            "item": [
                {
                    "name": "List Conversations",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/chat/conversations",
                            "host": ["{{baseUrl}}"],
                            "path": ["chat", "conversations"]
                        },
                        "description": "Liste les conversations de l'utilisateur courant."
                    }
                },
                {
                    "name": "Create/Find Direct Conversation",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"userId\": 2\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/chat/direct",
                            "host": ["{{baseUrl}}"],
                            "path": ["chat", "direct"]
                        },
                        "description": "Crée ou renvoie une conversation DIRECT avec userId."
                    }
                },
                {
                    "name": "Create/Find Task Conversation",
                    "request": {
                        "method": "POST",
                        "url": {
                            "raw": "{{baseUrl}}/chat/task/123",
                            "host": ["{{baseUrl}}"],
                            "path": ["chat", "task", "123"]
                        },
                        "description": "Crée ou renvoie une conversation liée à la tâche 123."
                    }
                },
                {
                    "name": "List Messages (paginated)",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/chat/conversations/conv_1/messages?limit=20",
                            "host": ["{{baseUrl}}"],
                            "path": ["chat", "conversations", "conv_1", "messages"],
                            "query": [
                                { "key": "limit", "value": "20" },
                                { "key": "cursor", "value": "", "disabled": true }
                            ]
                        },
                        "description": "Récupère les messages avec pagination. Utilisez cursor=<messageId> pour plus ancien."
                    }
                },
                {
                    "name": "Send Message",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"content\": \"Hello team!\",\n  \"replyToId\": null\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/chat/conversations/conv_1/messages",
                            "host": ["{{baseUrl}}"],
                            "path": ["chat", "conversations", "conv_1", "messages"]
                        },
                        "description": "Envoie un message; marque l'expéditeur comme ayant lu."
                    }
                },
                {
                    "name": "Mark Conversation Read",
                    "request": {
                        "method": "POST",
                        "url": {
                            "raw": "{{baseUrl}}/chat/conversations/conv_1/read",
                            "host": ["{{baseUrl}}"],
                            "path": ["chat", "conversations", "conv_1", "read"]
                        },
                        "description": "Marque tous les messages comme lus pour l'utilisateur courant."
                    }
                },
                {
                    "name": "Mark Conversation Unread",
                    "request": {
                        "method": "POST",
                        "url": {
                            "raw": "{{baseUrl}}/chat/conversations/conv_1/unread",
                            "host": ["{{baseUrl}}"],
                            "path": ["chat", "conversations", "conv_1", "unread"]
                        },
                        "description": "Efface lastReadAt pour l'utilisateur courant."
                    }
                },
                {
                    "name": "Edit Message",
                    "request": {
                        "method": "PATCH",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"content\": \"Updated content\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/chat/messages/msg_1",
                            "host": ["{{baseUrl}}"],
                            "path": ["chat", "messages", "msg_1"]
                        },
                        "description": "Édite un message de l'utilisateur; positionne isEdited."
                    }
                },
                {
                    "name": "Delete Message (soft)",
                    "request": {
                        "method": "DELETE",
                        "url": {
                            "raw": "{{baseUrl}}/chat/messages/msg_1",
                            "host": ["{{baseUrl}}"],
                            "path": ["chat", "messages", "msg_1"]
                        },
                        "description": "Supprime (soft) un message de l'utilisateur."
                    }
                },
                {
                    "name": "WebSocket Usage (info)",
                    "request": {
                        "auth": { "type": "noauth" },
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/chat/conversations",
                            "host": ["{{baseUrl}}"],
                            "path": ["chat", "conversations"]
                        },
                        "description": "Socket.io namespace /chat. Exemple:\\nconst socket = io(\\\"http://localhost:3000/chat\\\", { extraHeaders: { Authorization: \\\"Bearer {{token}}\\\" } });\\nsocket.emit(\\\"join\\\", \\\"conv_1\\\");\\nsocket.emit(\\\"message:send\\\", { conversationId: \\\"conv_1\\\", content: \\\"Hello!\\\" });\\nsocket.emit(\\\"typing:start\\\", \\\"conv_1\\\");\\nsocket.emit(\\\"message:read\\\", \\\"conv_1\\\");"
                    }
                }
            ]
        },
