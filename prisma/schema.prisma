generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  EMPLOYER
  ADMIN
}

enum ProjectStatus {
  EN_ATTENTE
  EN_COURS
  TERMINE
  ANNULE
}

enum SprintStatus {
  PLANIFIE
  EN_COURS
  TERMINE
}

enum TaskStatus {
  A_FAIRE
  EN_COURS
  TERMINE
}

enum NotificationType {
  NEW_MESSAGE
  MESSAGE_MENTION
  TASK_ASSIGNED
  TASK_UPDATED
  TASK_COMMENT
  TASK_MENTION
  DEADLINE_APPROACHING
  DEADLINE_OVERDUE
  PROJECT_UPDATE
  TEAM_ANNOUNCEMENT
  SYSTEM
}

model Utilisateur {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      Role
  avatar    String?
  telephone String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  client        Client?
  administrateur Administrateur?
  employer      Employer?
  conversationParticipants ConversationParticipant[]
  sentMessages   Message[]
  messageReadStatuses MessageReadStatus[]
  receivedNotifications  Notification[]        @relation("NotificationsReceived")
  sentNotifications      Notification[]        @relation("NotificationsSent")
  notificationPreference NotificationPreference?
  timeEntries            TimeEntry[]
  activeTimer            ActiveTimer?
  timeSummaries          TimeSummary[]

  @@map("utilisateurs")
}

// ─────────────────────────────────────────
// CLIENT
// ─────────────────────────────────────────

model Client {
  id           Int    @id @default(autoincrement())
  nomSociete   String
  localisation String
  utilisateurId Int          @unique
  utilisateur   Utilisateur  @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  projects Project[]
  @@map("clients")
}

// ─────────────────────────────────────────
// ADMINISTRATEUR
// ─────────────────────────────────────────

model Administrateur {
  id Int @id @default(autoincrement())
  utilisateurId Int          @unique
  utilisateur   Utilisateur  @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  @@map("administrateurs")
}

// ─────────────────────────────────────────
// GRADE
// ─────────────────────────────────────────

model Grade {
  id  Int    @id @default(autoincrement())
  nom String @unique
  employers Employer[]
  @@map("grades")
}
// ─────────────────────────────────────────
// EMPLOYER
// ─────────────────────────────────────────

model Employer {
  id     Int    @id @default(autoincrement())
  nom    String
  prenom String
  utilisateurId Int          @unique
  utilisateur   Utilisateur  @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  gradeId Int
  grade   Grade @relation(fields: [gradeId], references: [id]) 
  @@map("employers")
}

// ─────────────────────────────────────────
// PROJECT (base)
// ─────────────────────────────────────────

model Project {
  id          Int           @id @default(autoincrement())
  titre       String
  description String
  dateDebut   DateTime
  dateFin     DateTime
  status      ProjectStatus @default(EN_ATTENTE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  clientId Int
  client   Client @relation(fields: [clientId], references: [id])
  webProject       WebProject?
  marketingProject MarketingProject?

  @@map("projects")
}
// ─────────────────────────────────────────
// WEB PROJECT
// ─────────────────────────────────────────

model WebProject {
  id Int @id @default(autoincrement())

  projectId Int     @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  sprints Sprint[]

  @@map("web_projects")
}

// ─────────────────────────────────────────
// SPRINT
// ─────────────────────────────────────────

model Sprint {
  id              Int          @id @default(autoincrement())
  nom             String
  status          SprintStatus @default(PLANIFIE)
  goal            String?
  dateDebut       DateTime
  dateFin         DateTime
  totalStoryPoints Int         @default(0)

  webProjectId Int
  webProject   WebProject @relation(fields: [webProjectId], references: [id], onDelete: Cascade)

  sprintTasks SprintTask[]

  @@map("sprints")
}

// ─────────────────────────────────────────
// SPRINT TASKS
// ─────────────────────────────────────────

model SprintTask {
  id          Int        @id @default(autoincrement())
  titre       String
  status      TaskStatus @default(A_FAIRE)
  priority    Int        @default(1)
  dateDebut   DateTime
  storyPoints Int        @default(0)

  sprintId Int
  sprint   Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  @@map("sprint_tasks")
}

// ─────────────────────────────────────────
// MARKETING PROJECT
// ─────────────────────────────────────────
model MarketingProject {
  id Int @id @default(autoincrement())

  projectId Int     @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tasks Task[]

  @@map("marketing_projects")
}
// ─────────────────────────────────────────
// TASKS
// ─────────────────────────────────────────
model Task {
  id        Int        @id @default(autoincrement())
  titre     String
  dateDebut DateTime
  dateFin   DateTime
  status    TaskStatus @default(A_FAIRE)
  marketingProjectId Int
  marketingProject   MarketingProject @relation(fields: [marketingProjectId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  timeEntries  TimeEntry[]
  activeTimers ActiveTimer[]
  @@map("tasks")
}

// ─────────────────────────────────────────
// TIME TRACKING
// ─────────────────────────────────────────

model TimeEntry {
  id           String      @id @default(cuid())
  taskId       Int?        @map("task_id")
  userId       Int         @map("user_id")
  description  String?     @db.Text
  startTime    DateTime    @map("start_time")
  endTime      DateTime?   @map("end_time")
  duration     Int?
  billable     Boolean     @default(true)
  billableRate Float?      @map("billable_rate")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt      @map("updated_at")

  task         Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  user         Utilisateur  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startTime])
  @@index([taskId])
  @@index([userId, taskId])
  @@map("time_entries")
}

model ActiveTimer {
  id           String      @id @default(cuid())
  userId       Int         @unique @map("user_id")
  taskId       Int         @map("task_id")
  startTime    DateTime    @map("start_time")
  lastPausedAt DateTime?   @map("last_paused_at")
  totalPaused  Int         @default(0)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt      @map("updated_at")

  user         Utilisateur @relation(fields: [userId], references: [id], onDelete: Cascade)
  task         Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("active_timers")
}

model TimeSummary {
  id           String      @id @default(cuid())
  userId       Int         @map("user_id")
  date         DateTime    @map("date")
  totalSeconds Int         @default(0) @map("total_seconds")
  taskBreakdown Json?      @map("task_breakdown")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt      @map("updated_at")

  user         Utilisateur @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("time_summaries")
}

enum ConversationType {
  DIRECT
  TASK
}

model Conversation {
  id            String                    @id @default(cuid())
  type          ConversationType
  taskId        Int?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  lastMessageAt DateTime?                  @map("last_message_at")
  createdBy     Int                        @map("created_by")

  participants  ConversationParticipant[]
  messages      Message[]
  task          Task?          @relation(fields: [taskId], references: [id])

  @@index([taskId])
  @@index([lastMessageAt])
}

model ConversationParticipant {
  id             String        @id @default(cuid())
  conversationId String        @map("conversation_id")
  userId         Int           @map("user_id")
  joinedAt       DateTime      @default(now()) @map("joined_at")
  lastReadAt     DateTime?     @map("last_read_at")
  isActive       Boolean       @default(true)  @map("is_active")

  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           Utilisateur   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model Message {
  id             String         @id @default(cuid())
  content        String         @db.Text
  conversationId String         @map("conversation_id")
  senderId       Int            @map("sender_id")
  replyToId      String?        @map("reply_to_id")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt      @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")
  isEdited       Boolean        @default(false) @map("is_edited")

  conversation   Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         Utilisateur    @relation(fields: [senderId], references: [id])
  replyTo        Message?       @relation("MessageReplies", fields: [replyToId], references: [id])
  replies        Message[]      @relation("MessageReplies")
  readBy         MessageReadStatus[]

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([deletedAt])
}

model MessageReadStatus {
  id        String      @id @default(cuid())
  messageId String      @map("message_id")
  userId    Int         @map("user_id")
  readAt    DateTime    @default(now()) @map("read_at")

  message   Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      Utilisateur @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, readAt])
}

model Notification {
  id         String           @id @default(cuid())
  type       NotificationType
  title      String
  content    String?          @db.Text
  data       Json?
  userId     Int              @map("user_id")
  senderId   Int?             @map("sender_id")
  readAt     DateTime?        @map("read_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  expiresAt  DateTime?        @map("expires_at")

  user       Utilisateur      @relation("NotificationsReceived", fields: [userId], references: [id], onDelete: Cascade)
  sender     Utilisateur?     @relation("NotificationsSent", fields: [senderId], references: [id])

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([type])
  @@index([expiresAt])
}

model NotificationPreference {
  id                      String      @id @default(cuid())
  userId                  Int         @unique @map("user_id")

  emailNewMessage         Boolean     @default(true) @map("email_new_message")
  emailTaskAssigned       Boolean     @default(true) @map("email_task_assigned")
  emailDeadlineReminder   Boolean     @default(true) @map("email_deadline_reminder")

  inAppNewMessage         Boolean     @default(true) @map("in_app_new_message")
  inAppTaskAssigned       Boolean     @default(true) @map("in_app_task_assigned")
  inAppDeadlineReminder   Boolean     @default(true) @map("in_app_deadline_reminder")

  pushEnabled             Boolean     @default(false) @map("push_enabled")

  user                    Utilisateur @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}
